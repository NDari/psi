{
  // H-16: a language server through MCP (experiments.md). Trials are
  // headless, where a call that asks is denied, so every tool runs without
  // asking; the container is the boundary.
  "mcpServers": {
    "lsp": {
      "command": "/usr/local/bin/mcp-language-server",
      "args": ["--workspace", "/work/project", "--lsp", "pyright-langserver", "--", "--stdio"],
      "tools": ["definition", "references", "diagnostics", "hover", "rename_symbol"],
      "approval": "never"
    }
  }
}
