// The refuse list (design-going-forward.md): a bash command containing one of
// these is not run, and the model is told to leave it to the user. Each entry
// is a program, then words that must all appear after it in any order; a word
// written "!list" must not appear. For git, the first word must be the
// subcommand ("git commit -m push" isn't "git push").
// The list is short on purpose: the boundary, hidden credentials and
// checkpoints do the real work. Settings can append entries ("refuse");
// dropping a shipped one takes an explicit "refuse_remove".
{
  "refuse": [
    // Remote git actions fail anyway (no credentials inside the boundary).
    // Rewrites of local history are not here: checkpoints record the
    // branch tips, so /undo puts them back. A dropped stash is gone.
    "git push",
    "git stash drop",
    "git stash clear",

    // Publishing and deploying.
    "npm publish",
    "cargo publish",
    "docker push",
    "podman push",
    "terraform apply",
    "kubectl",

    // Privilege escalation.
    "sudo",
    "doas",

    // Psi itself, to prevent nested sessions (-p is short for --print).
    "psi -p",
    "psi --print",
    "psi --json"

    // Built in, not listed here: "rm .git", removing or moving the
    // repository's .git in any shape (rm, rmdir, mv, find -delete, a path
    // inside it, a dot-glob such as .*). Checkpoints can't undo it. Drop it
    // with "refuse_remove": ["rm .git"].
  ]
}
