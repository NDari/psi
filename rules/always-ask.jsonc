// Always-ask entries (psi-plan.md §8.3): a bash command containing one of these
// asks the user first, in every mode. Each entry is a program, then words that
// must all appear after it in any order ("git reset --hard" matches
// "git reset HEAD~1 --hard"); a word written "!list" must not appear. For git,
// the first word must be the subcommand ("git commit -m clean" isn't "git clean").
// User and project files can append entries; dropping a shipped one takes
// an explicit "remove".
{
  "always_ask": [
    // Irreversible or remote git actions.
    "git push",
    "git reset --hard",
    "git clean",
    "git branch -D",
    "git branch --delete --force",
    "git stash drop",
    "git stash clear",

    // Setting aside or discarding uncommitted work, which may be the
    // user's or another agent's (a sub-agent left its parent's changes in
    // a stash, 2026-11-04). Pop and apply put work back, so they don't ask.
    "git stash !list !show !pop !apply !drop !clear !branch",
    "git checkout",
    "git restore",

    // Publishing and deploying.
    "npm publish",
    "cargo publish",
    "docker push",
    "podman push",
    "terraform apply",
    "kubectl",

    // Privilege escalation.
    "sudo",
    "doas",

    // Psi itself, to prevent nested sessions (-p is short for --print).
    "psi -p",
    "psi --print",
    "psi --json"

    // Built in, not listed here: "rm .git", removing or moving the
    // repository's .git in any shape (rm, rmdir, mv, find -delete, a path
    // inside it, a dot-glob such as .*). Checkpoints can't undo it. Drop it
    // with "remove": ["rm .git"].
  ]
}
