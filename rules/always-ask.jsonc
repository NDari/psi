// Always-ask entries (psi-plan.md §8.3): a bash command containing one of these
// asks the user first, in every mode. Each entry is a program, then words that
// must all appear after it in any order ("git reset --hard" matches
// "git reset HEAD~1 --hard"). User and project files can append entries;
// dropping a shipped one takes an explicit "remove".
{
  "always_ask": [
    // Irreversible or remote git actions.
    "git push",
    "git reset --hard",
    "git clean",
    "git branch -D",
    "git branch --delete --force",
    "git stash drop",
    "git stash clear",

    // Publishing and deploying.
    "npm publish",
    "cargo publish",
    "docker push",
    "podman push",
    "terraform apply",
    "kubectl",

    // Privilege escalation.
    "sudo",
    "doas",

    // Psi itself, to prevent nested sessions (-p is short for --print).
    "psi -p",
    "psi --print",
    "psi --json"
  ]
}
